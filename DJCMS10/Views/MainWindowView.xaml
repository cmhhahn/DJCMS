<Window x:Class="DJCMS.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d"
       d:DesignHeight="400" d:DesignWidth="900"
        MinWidth="820"
        
        xmlns:local="clr-namespace:DJCMS.Models"
        xmlns:cal="http://caliburnmicro.com"
              
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="DJCMS - DJ Content Management System">

    <Window.Resources>

        <Color x:Key="AccentColor">#FF509bec</Color>
        <!-- DarkAccentColor: slightly darker for better contrast on selected items -->
        <Color x:Key="DarkAccentColor">#FF1b4d75</Color>

        <Color x:Key="GradientStop1">#001A1B1C</Color>
        <Color x:Key="GradientStop2">#222324</Color>

        <!-- Accent color: moved from CornflowerBlue to a cooler cyan-ice tone -->
          <SolidColorBrush x:Key="SpotifyAccentColor" Color="{StaticResource AccentColor}"/>
        <!-- Track/grey tones: given a very subtle cool-blue tint to unify with the accent -->
        <SolidColorBrush x:Key="SpotifyTrackBrush"
                            Color="#4A5258"/>
        <SolidColorBrush x:Key="SpotifyThumbBrush" Color="White"/>
        <!-- Generic control surface used where #444 was previously hardcoded -->
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#3E444A" />

        <SolidColorBrush x:Key="PlaylistBackgroundBrush"
                   Color="#111213"/>
        <SolidColorBrush x:Key="PlaylistItemBrush"
                   Color="#26282A"/>
        <SolidColorBrush x:Key="PlaylistHoverBrush"
                   Color="#31363E"/>
        <SolidColorBrush x:Key="PlaylistSelectedBrush"
                   Color="{StaticResource DarkAccentColor}"/>
        <SolidColorBrush x:Key="PlaylistTextBrush"
                   Color="#EEF6FA"/>
        <SolidColorBrush x:Key="PlaylistSecondaryTextBrush"
                   Color="#99A8B2"/>

        <!-- FilePath text style: turns white when its containing ListBoxItem is selected -->
        <Style x:Key="PlaylistFilePathStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlaylistSecondaryTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border BorderBrush="{StaticResource SpotifyAccentColor}"
            BorderThickness="1"
            Background="{StaticResource PlaylistBackgroundBrush}"
            CornerRadius="4">
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>

                  
                    <!-- Window Control Button Style -->
                    <Style x:Key="WindowControlButtonStyle"
                           TargetType="Button">
                        <Setter Property="Width"
                                Value="32"/>
                        <Setter Property="Height"
                                Value="32"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="#1000"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="4,0,0,0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#3666"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#4AAA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Volume slider style: moved below thumb style to avoid forward StaticResource reference -->

                    <Style x:Key="SpotifySliderThumbStyle"
                           TargetType="Thumb">
                        <Setter Property="Width"
                                Value="12"/>
                        <Setter Property="Height"
                                Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Ellipse Fill="{StaticResource SpotifyThumbBrush}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Volume slider style (similar to track style but without track-specific events) -->
                    <Style x:Key="VolumeSliderStyle"
                           TargetType="Slider">
                        <Setter Property="Height"
                                Value="20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                    <Grid Background="Transparent">
                                        <Grid VerticalAlignment="Center">
                                            <Track x:Name="PART_Track">
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Focusable="False"
                                                                  IsTabStop="False">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate>
                                                                <Border Height="4"
                                                                        Margin="-10,0,0,0"
                                                                        CornerRadius="2"
                                                                        Background="{StaticResource SpotifyTrackBrush}"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.IncreaseRepeatButton>

                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Focusable="False"
                                                                  IsTabStop="False">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate>
                                                                <Border Height="4"
                                                                        Margin="0,0,-6,0"
                                                                        CornerRadius="2"
                                                                        Background="{StaticResource SpotifyAccentColor}"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.DecreaseRepeatButton>

                                                <Track.Thumb>
                                                    <Thumb x:Name="VolumeThumb"
                                                           Style="{StaticResource SpotifySliderThumbStyle}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="VolumeThumb"
                                                 Property="IsMouseOver"
                                                 Value="False">
                                            <Setter TargetName="VolumeThumb"
                                                    Property="Opacity"
                                                    Value="0.0"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="VolumeThumb"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                  
                    <Style x:Key="SpotifySliderStyle"
                           TargetType="Slider">
                        <Setter Property="Height"
                                Value="20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                    <Grid Background="Transparent">
                                        <Grid VerticalAlignment="Center">
                                            <Track x:Name="PART_Track">
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Focusable="False"
                                                                  IsTabStop="False">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate>
                                                                <Border Height="4"
                                                                        Margin="-10,0,0,0"
                                                                        CornerRadius="2"
                                                                        Background="{StaticResource SpotifyTrackBrush}"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.IncreaseRepeatButton>

                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Focusable="False"
                                                                  IsTabStop="False">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate>
                                                                <Border Height="4"
                                                                        Margin="0,0,-6,0"
                                                                        CornerRadius="2"
                                                                        Background="{StaticResource SpotifyAccentColor}"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.DecreaseRepeatButton>

                                                <Track.Thumb>
                                                    <Thumb x:Name="TrackProgressThumb"
                                                           cal:Message.Attach="[Event DragStarted] = [Action TrackProgressDragStarted()];
                                                                            [Event DragCompleted] = [Action TrackProgressDragCompleted()]"
                                                           Style="{StaticResource SpotifySliderThumbStyle}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="TrackProgressThumb"
                                                 Property="IsMouseOver"
                                                 Value="False">
                                            <Setter TargetName="TrackProgressThumb"
                                                    Property="Opacity"
                                                    Value="0.0"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="TrackProgressThumb"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="Button">
                        <Style.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource ControlSurfaceBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="2">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style.Setters>
                    </Style>

                    <Style x:Key="Button2" TargetType="Button">
                        <Style.Setters>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource ControlSurfaceBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="2">
                                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style.Setters>
                    </Style>

                    <Style x:Key="DarkPlaylistListBoxStyle"
                           TargetType="ListBox">
                        <Setter Property="Background"
                                Value="{StaticResource PlaylistBackgroundBrush}"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource PlaylistTextBrush}"/>
                        <Setter Property="Padding"
                                Value="6"/>
                    </Style>

                    <Style x:Key="DarkPlaylistItemStyle"
                           TargetType="ListBoxItem">
                        <Setter Property="Padding"
                                Value="4"/>
                        <Setter Property="Margin"
                                Value="0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="AllowDrop"
                                Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Background="Transparent" Margin="0">
                                        <Grid Margin="2">
                                            <Border x:Name="Border"
                                                    Background="{StaticResource PlaylistItemBrush}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0"
                                                    BorderBrush="Transparent"
                                                    Panel.ZIndex="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <Border x:Name="DropIndicatorTop"
                                                    Height="3"
                                                    Background="{StaticResource SpotifyAccentColor}"
                                                    CornerRadius="2"
                                                    Margin="8,-3.5"
                                                    VerticalAlignment="Top"
                                                    Opacity="0"
                                                    Panel.ZIndex="1"
                                                    IsHitTestVisible="False"/>
                                            <Border x:Name="DropIndicatorBottom"
                                                    Height="3"
                                                    Background="{StaticResource SpotifyAccentColor}"
                                                    CornerRadius="2"
                                                    Margin="8,-3.5"
                                                    VerticalAlignment="Bottom"
                                                    Opacity="0"
                                                    Panel.ZIndex="1"
                                                    IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="{StaticResource PlaylistHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="{StaticResource PlaylistSelectedBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                                                     Value="DragOverTop">
                                            <Setter TargetName="DropIndicatorTop"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                                                     Value="DragOverBottom">
                                            <Setter TargetName="DropIndicatorBottom"
                                                    Property="Opacity"
                                                    Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                                                     Value="Dragging">
                                            <Setter TargetName="Border"
                                                    Property="Opacity"
                                                    Value="0.5"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                     Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="PreviewMouseMove"
                                     Handler="ListBoxItem_PreviewMouseMove"/>
                        <EventSetter Event="Drop"
                                     Handler="ListBoxItem_Drop"/>
                        <EventSetter Event="DragOver"
                                     Handler="ListBoxItem_DragOver"/>
                        <EventSetter Event="DragLeave"
                                     Handler="ListBoxItem_DragLeave"/>
                    </Style>

                    <Style x:Key="DarkPlaylistItemStyle2" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Background="Transparent" Margin="0">
                                        <Grid Margin="2">
                                            <Border x:Name="Border"
                                                Background="{StaticResource PlaylistItemBrush}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                BorderBrush="Transparent"
                                                Panel.ZIndex="0">
                                                <ContentPresenter/>
                                            </Border>                                            
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                             Value="True">
                                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{StaticResource PlaylistHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                             Value="True">
                                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{StaticResource PlaylistSelectedBrush}"/>
                                        </Trigger>                                       
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseLeftButtonDown"
                 Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="PreviewMouseMove"
                 Handler="ListBoxItem_PreviewMouseMove"/>                        
                        <EventSetter Event="DragOver"
                 Handler="ListBoxItem_DragOver"/>
                        <EventSetter Event="DragLeave"
                 Handler="ListBoxItem_DragLeave"/>
                    </Style>

                    <Geometry x:Key="PlayGeometry">
                        M 0,0 L 0,20 L 18,10 Z
                    </Geometry>

                    <Geometry x:Key="PauseGeometry">
                        M 0,0 L 0,20 L 6,20 L 6,0 Z
    M 12,0 L 12,20 L 18,20 L 18,0 Z
                    </Geometry>

                    <Style x:Key="PlayPauseButton" TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid x:Name="wholeButton" Opacity="1">
                                        <Ellipse x:Name="ButtonBack" Fill="{StaticResource SpotifyTrackBrush}" />
                                        <Path x:Name="PlayPauseIcon" Fill="White"
                                            Data="{StaticResource PlayGeometry}"
                                            Width="18"
                                            Height="20"
                                            Stretch="Fill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>                                       
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"  Value="True">
                                            <Setter TargetName="PlayPauseIcon" Property="Data" Value="{StaticResource PauseGeometry}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBack" Property="Fill" Value="{StaticResource SpotifyAccentColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="wholeButton" Property="Opacity" Value="0.9" />                                            
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>



                    <!-- Popup menu button style for the custom app-styled menu -->
                    <Style x:Key="PopupMenuButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Padding="{TemplateBinding Padding}" CornerRadius="4"
                                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource PlaylistHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SpotifyAccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </ResourceDictionary>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
           
            <!-- Custom Title Bar -->
            <Grid x:Name="TitleBarGrid">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="{StaticResource GradientStop1}"
                                      Offset="0"/>
                        <GradientStop Color="{StaticResource GradientStop2}"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>


                <TextBlock Text="DJCMS - DJ Content Management System"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"/>

                <Grid Background="Transparent"
                      Grid.Row="0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                      PreviewMouseMove="UIElement_OnPreviewMouseMove"
                      Margin="0,0,116,0"/>

                <!-- Top-left menu button (opens a small dropdown) -->
                <Button x:Name="MenuButton"
                        Style="{StaticResource WindowControlButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,4,0,0"
                        Click="MenuButton_Click">
                    <TextBlock Text="☰"
                               FontSize="14"
                               Opacity="0.9"/>
                </Button>

                <!-- App-styled popup menu that replaces the system context menu -->
                <Popup x:Name="MenuPopup"
                       PlacementTarget="{Binding ElementName=MenuButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Slide"
                       DataContext="{Binding DataContext, ElementName=MenuButton}">
                    <Border Background="{StaticResource PlaylistItemBrush}"
                            CornerRadius="6"
                            Padding="4"
                            BorderBrush="{StaticResource SpotifyAccentColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <Button Style="{StaticResource PopupMenuButtonStyle}"
                                    cal:Message.Attach="[Event Click] = [Action SavePlaylist()]">
                                Save Playlist
                            </Button>
                            <Button Style="{StaticResource PopupMenuButtonStyle}"
                                    cal:Message.Attach="[Event Click] = [Action LoadPlaylist()]">
                                Load Playlist
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="4,4">
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="─"
                                   FontSize="16"
                                   Margin="0,2,0,0"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeButton_Click">
                        <TextBlock Text="□"
                                   FontSize="20"
                                   Margin="0,-5,0,0"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕"
                                   FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainArea" Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Library"
                     Margin="10" Grid.Column="0"
                     ItemsSource="{Binding LibraryFolder}"
                     SelectedItem="{Binding LibraryItem}"
                     ItemContainerStyle="{StaticResource DarkPlaylistItemStyle2}"
                     Style="{StaticResource DarkPlaylistListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PlaylistTrack}">                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <Button Content="+" cal:Message.Attach="[Event Click] = [Action AddTrack($dataContext.ID)]" />
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PlaylistTextBrush}"/>                                
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="Tracks"
                         Margin="10" Grid.Column="2"
                         SelectedItem="{Binding SelectedTrack}"
                         ItemContainerStyle="{StaticResource DarkPlaylistItemStyle}"
                         Style="{StaticResource DarkPlaylistListBoxStyle}"
                         AllowDrop="True"
                         Drop="ListBox_Drop"
                         DragOver="ListBox_DragOver">
                        <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PlaylistTrack}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PlaylistTextBrush}"/>
                                <TextBlock Text="{Binding FilePath}"
                                           FontSize="11"
                                           Style="{StaticResource PlaylistFilePathStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="-"
                                        cal:Message.Attach="[Event Click] = [Action Minus($dataContext.ID)]" />
                                <Border Background="{StaticResource ControlSurfaceBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding GapSeconds, StringFormat={}{0:+0.##;-0.##;0}s}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="+"
                                        cal:Message.Attach="[Event Click] = [Action Plus($dataContext.ID)]"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>


            <Grid Grid.Row="2" x:Name="BottomBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Grid x:Name="AudioControl" Grid.Column="1">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Slider Style="{StaticResource SpotifySliderStyle}"
                                Maximum="1.0"
                                Value="{Binding TrackProgress, Mode=TwoWay}"
                                Width="500"
                                Margin="20"/>

                        <ToggleButton Width="50" Height="50" x:Name="TogglePlay" IsChecked="{Binding IsPlaying, Mode=OneWay}"
                             Style="{StaticResource PlayPauseButton}"
                            BorderThickness="0">
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <Grid x:Name="RightControls" Grid.Column="3">
                    <Button x:Name="FullScreenButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Grid.Row="2"
                        Style="{StaticResource WindowControlButtonStyle}"
                        Click="FullScreenButton_Click">
                                        <TextBlock Text="⛶"
                               FontSize="14"
                               Margin="0,-5,0,0"
                               Opacity="0.5"/>
                    </Button>

                    <!-- Volume slider placed to the left of the fullscreen button -->
                    <Slider Style="{StaticResource VolumeSliderStyle}"
                            Maximum="1.0"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Width="140"
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,56,10"/>
                </Grid>
            </Grid>
            



            <!-- Resize thumbs: edges and corners -->
            <Grid IsHitTestVisible="True" Opacity="0.0" Grid.RowSpan="3" Margin="-5">
                <!-- Edges -->
                <Thumb x:Name="ResizeLeft" Width="8" HorizontalAlignment="Left" Cursor="SizeWE" Background="Transparent" DragDelta="ResizeLeft_DragDelta"/>
                <Thumb x:Name="ResizeRight" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Background="Transparent" DragDelta="ResizeRight_DragDelta"/>
                <Thumb x:Name="ResizeTop" Height="8" VerticalAlignment="Top" Cursor="SizeNS" Background="Transparent" DragDelta="ResizeTop_DragDelta"/>
                <Thumb x:Name="ResizeBottom" Height="8" VerticalAlignment="Bottom" Cursor="SizeNS" Background="Transparent" DragDelta="ResizeBottom_DragDelta"/>

                <!-- Corners -->
                <Thumb x:Name="ResizeTopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Transparent" DragDelta="ResizeTopLeft_DragDelta"/>
                <Thumb x:Name="ResizeTopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Background="Transparent" DragDelta="ResizeTopRight_DragDelta"/>
                <Thumb x:Name="ResizeBottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Transparent" DragDelta="ResizeBottomLeft_DragDelta"/>
                <Thumb x:Name="ResizeBottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" DragDelta="ResizeBottomRight_DragDelta"/>
            </Grid>
        </Grid>
    </Border>
</Window>
